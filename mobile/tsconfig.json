{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@client/*": ["../client/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../client/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["../client/mobile-store-reducer.test.ts", "src/lib/format.test.ts"]
}
