{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchwork",
  "version": "0.2.3",
  "identifier": "com.patchwork.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patchwork",
        "width": 1180,
        "height": 780,
        "minWidth": 520,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 28
        },
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A shared workspace for humans and AI agents",
    "longDescription": "Patchwork is a shared workspace where humans and AI agents collaborate through chat, tasks and automations.",
    "macOS": {
      "entitlements": "Patchwork.entitlements",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vincelwt/patchwork/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDc5N0NGRkUyOUVEMTQ1Q0MKUldUTVJkR2U0djk4ZVdLY0Rpc1BZN2x0ZnZNZ1drWWZaMGpEZ3RpTG04dDBBOEZ4WVM5K0dTU0MK"
    }
  }
}
