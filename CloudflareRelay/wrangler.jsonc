{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-desktop-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-17",
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "Relay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] }
  ],
  "assets": {
    "directory": "../Sources/PiDeskWeb/Site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/relay/*"]
  },
  "routes": [
    { "pattern": "remote.ai.gloom.sh", "custom_domain": true }
  ]
}
